<Project>

  <!-- 根级构建属性（全局）。刻意只放 CPM 一项（沿 monorepo 根同名文件的最小约定迁入）：
       - TargetFramework/Nullable/ImplicitUsings 各 C# 项目已 100% 自持；Harness.FSharp（唯一 F# 项目）
       未声明 ImplicitUsings——全局 enable 会翻转其编译行为（F# 隐式 open）；
       - LangVersion 由 SDK 默认（net10.0 → latest）覆盖，无需重复。
       包版本唯一权威见 Directory.Packages.props。 -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Microsoft Agent Framework 把部分 Harness/Responses API 标成 experimental（MAAI001）。
         Aether 有意包这些 API 并对外只暴露稳定类型——所以在这个仓统一抑制一次，
         而不是每个用到 MAF 的项目各写一遍（之前 Harness/Hosting/Mcp×2 各抄了一份）。
         NU5104（预发布包依赖）**不**在这里抑制：它只与 Mcp 的 prerelease 包有关，留在那两个项目里。 -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

</Project>
